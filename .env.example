# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DB=hr_db
POSTGRES_USER=hr_user
POSTGRES_PASSWORD=secure_password

# HR ETL
DATA_DIR=./data
HR_EXCEL_FILENAME=ш.xlsx
LOG_LEVEL=INFO
MAX_RETRIES=3
RETRY_DELAY_SECONDS=5

HR_SCHEMA_MAPPING_PATH=./config/hr_schema_mapping.json
HR_BATCH_SIZE=5000
HR_REJECT_BATCH_SIZE=1000
HR_FUZZY_THRESHOLD=85

# Dashboard
DASH_HOST=127.0.0.1
DASH_PORT=8050
DASH_DEBUG=false
